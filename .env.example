# Nora Studio Environment Configuration Example
# Copy this file to .env and fill in your details

# Web Dashboard Port (Default: 3000)
PORT=3000

# Discord Bot Token (Get from Discord Developer Portal -> Bot -> Token)
TOKEN=your_discord_bot_token_here

# Public API Base URL for Web Dashboard (Default: http://localhost:3000 or your domain)
API_BASE_URL=http://localhost:3000

# Security Encryption Key (32-byte hexadecimal key for session encryption)
ENCRYPTION_KEY=630d9891d922a1f0f336ed854d119da7f381b5b3ae94c3f8ce3b58829aa09076

# Optional: AI Provider Keys (for Aura AI Chatbot & AutoMod features)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Roblox Integration & OAuth2 (for Roblox Verification module)
ROBLOX_CLIENT_ID=your_roblox_client_id_here
ROBLOX_CLIENT_SECRET=your_roblox_client_secret_here
ROBLOX_REDIRECT_URI=http://localhost:3000/api/user/roblox/callback

# Optional: Top.gg Bot Listing Token (for server count updates)
TOPGG_TOKEN=your_topgg_token_here
